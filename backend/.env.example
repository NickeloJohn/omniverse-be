APP_NAME=MARS-NAV API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://marsnav:marsnav@localhost:5434/marsnav
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
DATA_DIR=./data
# INGEST_INPUT_DIR=./data/inbox
NASA_ALLOWED_HOSTS=["trek.nasa.gov","astrogeology.usgs.gov","planetarymaps.usgs.gov","ode.rsl.wustl.edu","pds-geosciences.wustl.edu"]
MAX_DOWNLOAD_MB=2048
ROUTE_SEARCH_TIMEOUT_S=15
ROUTE_MAX_EXPANSIONS=2000000
ROUTE_MAX_DESTINATIONS=12
ROUTE_RATE_LIMIT_PER_MIN=30
ROUTE_MAX_CONCURRENT=2